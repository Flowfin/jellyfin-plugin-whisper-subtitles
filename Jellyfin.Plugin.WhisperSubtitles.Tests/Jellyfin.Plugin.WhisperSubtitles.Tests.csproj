<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(SupportedServerLines)</TargetFrameworks>
    <UsesJellyfinPackages>true</UsesJellyfinPackages>
    <RootNamespace>Jellyfin.Plugin.WhisperSubtitles.Tests</RootNamespace>
    <AssemblyName>Jellyfin.Plugin.WhisperSubtitles.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- The whole suppression list for this project, three rules, each one about the
       shape of a test rather than about anything that ships.

       CA1707, no underscores in a member name. A test name here is a sentence, and
       the sentence is what a failing run prints. The alternative spelling loses
       the reading that makes a red run legible without opening the file.

       CA1861, a constant array argument should be a static readonly field. The
       arrays in these tests are the input the assertion beneath them is about, and
       hoisting each one to a field puts the data a reader needs on a different
       screen from the thing it is being fed to.

       SA0001, XML comment analysis is disabled by the project configuration. It is
       a report about the build rather than about any line: this project produces
       no documentation file, because nothing consumes documentation for a test
       assembly, and StyleCop says so once per compilation. Turning the file on to
       silence it would trade this for a missing-comment warning on every public
       test method.

       Everything else the settings refuse is suppressed at the line that needs it,
       with its reason written there. -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);CA1707;CA1861;SA0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <!-- The coverage collector, which produces a report only when the run asks for
       it on the command line. An ordinary `dotnet test` is unchanged and pays
       nothing for it, and the run that enforces the floor is the same run that
       executes the tests rather than a second pass over a second build. -->
  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="[6.0.2]" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Jellyfin.Plugin.WhisperSubtitles\Jellyfin.Plugin.WhisperSubtitles.csproj" />
  </ItemGroup>

  <!-- The plugin excludes the Jellyfin runtime assemblies because the server
       supplies them, which is right for what ships and leaves the test host with
       nothing to load the plugin against. These bring the same pinned version back
       for the test run only, read from the one place that names it. -->
  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="$(JellyfinPackageVersion)" />
    <PackageReference Include="Jellyfin.Model" Version="$(JellyfinPackageVersion)" />
  </ItemGroup>

  <!-- Subtitle fixtures are compared byte for byte, so they are copied rather
       than embedded: an embedded resource is read out of the assembly the build
       produced, and what these assert on is the file a clone checked out. -->
  <ItemGroup>
    <None Include="Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The manifest is one half of the identity comparison, so the test needs the
       real file rather than a copy of its contents. -->
  <ItemGroup>
    <None Include="..\build.yaml" Link="build.yaml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The troubleshooting page is compared against the failure reasons in the
       code, so the test reads the file a clone checked out rather than a second
       copy of its contents. Same reasoning as the manifest above. -->
  <ItemGroup>
    <None Include="..\docs\troubleshooting.md" Link="docs\troubleshooting.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The other half is what the build actually produced. These carry it into the
       test assembly from the properties the build itself used, so the comparison
       is against the real values and not against a second copy of them written
       out by hand. SupportedServerLines is every framework this tree builds;
       JellyfinServerLine is the server line of the framework this particular run
       was compiled for. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>SupportedServerLines</_Parameter1>
      <_Parameter2>$(SupportedServerLines)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>JellyfinServerLine</_Parameter1>
      <_Parameter2>$(JellyfinServerLine)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>TargetFramework</_Parameter1>
      <_Parameter2>$(TargetFramework)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
