<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(SupportedServerLines)</TargetFrameworks>
    <UsesJellyfinPackages>true</UsesJellyfinPackages>
    <RootNamespace>Jellyfin.Plugin.WhisperSubtitles.Tests</RootNamespace>
    <AssemblyName>Jellyfin.Plugin.WhisperSubtitles.Tests</AssemblyName>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Jellyfin.Plugin.WhisperSubtitles\Jellyfin.Plugin.WhisperSubtitles.csproj" />
  </ItemGroup>

  <!-- The plugin excludes the Jellyfin runtime assemblies because the server
       supplies them, which is right for what ships and leaves the test host with
       nothing to load the plugin against. These bring the same pinned version back
       for the test run only, read from the one place that names it. -->
  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="$(JellyfinPackageVersion)" />
    <PackageReference Include="Jellyfin.Model" Version="$(JellyfinPackageVersion)" />
  </ItemGroup>

  <!-- The manifest is one half of the identity comparison, so the test needs the
       real file rather than a copy of its contents. -->
  <ItemGroup>
    <None Include="..\build.yaml" Link="build.yaml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The other half is what the build actually produced. These carry it into the
       test assembly from the properties the build itself used, so the comparison
       is against the real values and not against a second copy of them written
       out by hand. SupportedServerLines is every framework this tree builds;
       JellyfinServerLine is the server line of the framework this particular run
       was compiled for. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>SupportedServerLines</_Parameter1>
      <_Parameter2>$(SupportedServerLines)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>JellyfinServerLine</_Parameter1>
      <_Parameter2>$(JellyfinServerLine)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>TargetFramework</_Parameter1>
      <_Parameter2>$(TargetFramework)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
