name: 'Pull request hygiene'

on:
  pull_request_target:
    types: [opened, edited, synchronize, reopened]

permissions: {}

# This repository carries no label sync and will not: a sync-labels run replaces
# the whole label set with a list another organisation maintains, so every label
# this board declares for itself is deleted on a schedule. The labels here are
# written by hand and by this job, which annotates rather than replaces.
jobs:
  hygiene:
    name: Pull request hygiene
    runs-on: ubuntu-latest
    permissions:
      pull-requests: write
    steps:
      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2
      - run: ./checks/pr-hygiene
