using System.Threading;
using System.Threading.Tasks;
using Microsoft.AspNetCore.Mvc;

namespace Jellyfin.Plugin.WhisperSubtitles.Api;

/// <summary>
/// A small surface for the configuration page to ask whether the selected backend is
/// ready, so the page can say so without a save. Useful, plausible, and a path on the
/// server that no record of this plugin's claims ever learned about.
/// </summary>
[ApiController]
[Route("WhisperSubtitles")]
public sealed class ReadinessController : ControllerBase
{
    [HttpGet("Readiness")]
    public Task<ActionResult<string>> Readiness(CancellationToken cancellationToken) =>
        Task.FromResult<ActionResult<string>>(Ok("ready"));
}
