<div id="WhisperSubtitlesConfigPage">
    <div class="fieldDescription">
        Whether a file is there, whether it runs and whether it is a model are
        answered when the backend is asked.
    </div>
    <script type="text/javascript">
        function load() {
            return ApiClient.getVirtualFolders().then(function (libraries) {
                return ApiClient.getPluginConfiguration(pluginUniqueId).then(function (config) {
                    render(config, libraries);
                });
            });
        }

        function save(config) {
            return ApiClient.updatePluginConfiguration(pluginUniqueId, config);
        }
    </script>
</div>
