<Project>
    <!-- The version, read out of build.yaml rather than written here as well. The
         manifest is the copy a server compares against what it has installed and
         the copy a catalogue lists, and the packager already takes the number out
         of it, so deriving in this direction leaves one number in one file and
         deriving in the other would ask the release route to evaluate a project
         property it never loads.

         A line match and not a YAML parser, which is the same bound the identity
         test's manifest reader carries: a key at column zero whose value is a
         plain quoted scalar on the same line. An anchor or a block scalar would
         defeat it, and the manifest is flat because jprm writes and reads it in
         that shape. The end of the line is deliberately not anchored, so a clone
         that checked the file out with carriage returns reads the same number as
         one that did not.

         A pattern that stops matching leaves this empty, and an empty
         AssemblyVersion is not an error: the SDK stamps its own default and the
         assembly ships carrying a number nobody wrote. RefuseAVersionNothingRead
         in Directory.Build.targets is what refuses that case. -->
    <PropertyGroup>
        <!-- The graph is watched, not only recorded. NuGet checks the restored graph
             against the advisory database and NU1901 to NU1904 are raised to errors, so a
             known-vulnerable package fails the restore. Left as warnings they would be
             true and green, printed into a log nobody reads.
    
             This board committed a lockfile and ran no audit, which is the worse half of
             the pair: the graph was held still and nothing looked at it. Eleven boards of
             this fleet were in that state on 2026-08-18, and the twelfth is why it
             matters. jellyfin-plugin-watchlist was told by Scorecard about one high
             advisory; switching this on found a second one rated critical that Scorecard
             had never reported.
    
             Mode all rather than direct: both of those arrived under the Jellyfin
             packages and neither was referenced by a project file, so a direct-only audit
             would have found neither.
    
             Nothing is pinned here. Measured with the audit forced on from the command
             line, this board reports no advisory today; the entry is the detector, not a
             repair.
    
             Note for whoever edits this comment: an XML comment may not contain two
             hyphens in a row. A draft elsewhere in this fleet spelled out a command line
             flag, left the file malformed, and the build failed on a property defined
             twenty lines below. -->
        <NuGetAudit>true</NuGetAudit>
        <NuGetAuditMode>all</NuGetAuditMode>
        <NuGetAuditLevel>low</NuGetAuditLevel>
        <WarningsAsErrors>$(WarningsAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsAsErrors>
    </PropertyGroup>

    <PropertyGroup>
        <PluginManifest>$(MSBuildThisFileDirectory)build.yaml</PluginManifest>
        <PluginVersion>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(PluginManifest)')), '(?m)^version:[ \t]*"([0-9]+(?:\.[0-9]+){1,3})"').Groups.get_Item(1).Value)</PluginVersion>
        <Version>$(PluginVersion)</Version>
        <AssemblyVersion>$(PluginVersion)</AssemblyVersion>
        <FileVersion>$(PluginVersion)</FileVersion>
    </PropertyGroup>

    <!-- The supported server lines. This is the one place a target framework or a
         Jellyfin package version is written; every project reads them from here, so
         a line cannot be half-changed in one project and left alone in another. -->
    <PropertyGroup>
        <SupportedServerLines>net9.0;net10.0</SupportedServerLines>
    </PropertyGroup>

    <PropertyGroup Condition="'$(TargetFramework)' == 'net9.0'">
        <JellyfinServerLine>10.11</JellyfinServerLine>
        <JellyfinPackageVersion>10.11.11</JellyfinPackageVersion>
    </PropertyGroup>

    <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
        <JellyfinServerLine>12.0</JellyfinServerLine>
        <JellyfinPackageVersion>12.0.0-rc4</JellyfinPackageVersion>
    </PropertyGroup>

    <!-- The analysis settings, for every project in this tree and every project it
         later gains. They were written out in one project file, which makes each
         new project a fresh decision about whether to repeat them, and the answer
         nobody notices is the one where a project quietly has none of them.

         MSBuildThisFileDirectory rather than a relative path: the ruleset is
         resolved against the project that reads the property, so '../' is right
         only for a project one directory down and silently names nothing anywhere
         else, and a CodeAnalysisRuleSet pointing at no file is not an error. -->
    <PropertyGroup>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <Nullable>enable</Nullable>
        <AnalysisMode>AllEnabledByDefault</AnalysisMode>
        <CodeAnalysisRuleSet>$(MSBuildThisFileDirectory)jellyfin.ruleset</CodeAnalysisRuleSet>
    </PropertyGroup>

    <!-- The analyzers themselves, on the same terms. Each version is an exact
         range rather than a bare number: a bare number is a floor, so a restore
         that resolves higher changes which diagnostics the build refuses without
         anything in the tree changing, and a build that fails on a rule nobody
         added is how a strict setting gets turned off.

         The analyzers the SDK carries are not pinned here and cannot be: their set
         follows the SDK the runner installed, and AnalysisLevel would fix it only
         at the cost of a build that refuses the older of the two SDKs this tree is
         built with. -->
    <ItemGroup>
        <PackageReference Include="SerilogAnalyzer" Version="[0.15.0]" PrivateAssets="All" />
        <PackageReference Include="StyleCop.Analyzers" Version="[1.2.0-beta.556]" PrivateAssets="All" />
        <PackageReference Include="SmartAnalyzers.MultithreadingAnalyzer" Version="[1.1.31]" PrivateAssets="All" />
    </ItemGroup>
</Project>
